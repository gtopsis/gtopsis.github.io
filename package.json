{
  "name": "gtopsis.github.io",
  "description": "Personal website",
  "author": "gtopsis",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtopsis/gtopsis.github.io"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=8.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxi build",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "prettier:fix": "pnpx prettier . --write",
    "lint:js": "eslint",
    "lint": "pnpm run lint:js && pnpm run lint:prettier",
    "lint:fix": "prettier --write --list-different . && pnpm run lint:js --fix",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .nuxt dist .output"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.23",
    "globals": "^17.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/test-utils": "^4.3.2",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^20.14.5",
    "nuxi": "^3.37.0",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vuetify": "^4.2.1"
  },
  "overrides": {
    "vue": "latest",
    "typescript": "^5.9.3"
  }
