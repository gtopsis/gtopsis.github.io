{
  "name": "gtopsis.github.io",
  "description": "Personal website",
  "author": "gtopsis",
  "repository": {
    "type": "git",
    "url": "https://github.com/gtopsis/gtopsis.github.io"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxi build",
    "dev": "nuxi dev",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "postinstall": "nuxi prepare",
    "prettier:fix": "pnpx prettier . --write",
    "lint:js": "eslint",
    "lint": "pnpm run lint:js && pnpm run lint:prettier",
    "lint:fix": "prettier --write --list-different . && pnpm run lint:js --fix",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .nuxt dist .output"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "core-js": "^3.50.0",
    "dayjs": "^1.11.23",
    "globals": "^16.5.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/image-edge": "1.3.0-28493895.369b747",
    "@nuxt/test-utils": "^3.23.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@pinia/nuxt": "0.11.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "happy-dom": "^17.6.3",
    "nuxi": "^3.37.0",
    "nuxt": "^3.21.11",
    "pinia": "^3.0.4",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.7",
    "vuetify": "^3.13.2"
  },
  "overrides": {
    "vue": "latest"
  }
